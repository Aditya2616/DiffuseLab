# DiffuseLab needs no API keys. Everything below is optional.
DIFFUSELAB_DEVICE=auto      # auto | cuda | cpu
DIFFUSELAB_PORT=8105          # port for 'diffuselab serve'
DIFFUSELAB_CKPT=checkpoints   # where trained checkpoints are read from
DIFFUSELAB_DOCS=            # serve a different static site folder
DIFFUSELAB_NO_GRAPH=        # set to 1 to turn off CUDA-graph training
HF_HOME=                    # override the Hugging Face cache location
